	measure 'Crescimento 2027 · cenário baixo' = AVERAGE ( previsao_resumo_anual[CRESC_2027_P10] ) / 100
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 7. Previsão
		lineageTag: d7adee7e-fa02-42ef-8f11-cfd77b8cd791

	measure 'Crescimento 2027 · cenário alto' = AVERAGE ( previsao_resumo_anual[CRESC_2027_P90] ) / 100
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 7. Previsão
		lineageTag: 66cc6f87-6b06-4415-a71d-fc8a0a95e12d

	measure 'Online · Portugal (real e cenário)' =
			-- Valor real até 2025; curva logística (cenário) a partir de 2026.
			VAR r = CALCULATE ( AVERAGE ( fato_projecao_online[PCT_COMPROU_12M] ), fato_projecao_online[CO_GEO] = "PT" )
			RETURN
			    COALESCE ( r, CALCULATE ( AVERAGE ( fato_projecao_online[CURVA] ), fato_projecao_online[CO_GEO] = "PT" ) ) / 100
		formatString: 0.0%
		displayFolder: 7. Previsão
		lineageTag: 39ebeebf-628c-4655-b863-22cd38d865d4

	measure 'Online · UE27 (real e cenário)' =
			VAR r = CALCULATE ( AVERAGE ( fato_projecao_online[PCT_COMPROU_12M] ), fato_projecao_online[CO_GEO] = "EU27_2020" )
			RETURN
			    COALESCE ( r, CALCULATE ( AVERAGE ( fato_projecao_online[CURVA] ), fato_projecao_online[CO_GEO] = "EU27_2020" ) ) / 100
		formatString: 0.0%
		displayFolder: 7. Previsão
		lineageTag: 1b42d105-6d9c-4c5f-9de8-e4dd36ab8a2f

	measure 'Erro do modelo (MAPE)' = AVERAGE ( previsao_metricas[MAPE_PCT] ) / 100
		formatString: 0.0%
		displayFolder: 7. Previsão
		lineageTag: 28a678fe-b806-41be-a854-531d58af986d

	column Coluna
		dataType: string
		isHidden
		lineageTag: 5c41f17f-91fd-4e3b-a67a-73ae8d31f56a
		sourceColumn: Coluna

	partition _Medidas = m
		mode: import
		source =
				let
				    Fonte = #table(type table [Coluna = text], {})
				in
				    Fonte


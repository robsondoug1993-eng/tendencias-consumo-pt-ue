		summarizeBy: none
		sourceColumn: ORDEM

	partition dim_categoria_online = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaSaida & "dim_categoria_online.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"CO_CATEGORIA", type text}, {"NO_CATEGORIA", type text}, {"TIPO", type text}, {"ORDEM", Int64.Type}}, "pt-PT")
				in
				    Tipos


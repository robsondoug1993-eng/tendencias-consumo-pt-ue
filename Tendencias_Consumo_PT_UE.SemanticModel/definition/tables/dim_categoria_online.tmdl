table dim_categoria_online
	lineageTag: 006f640f-78a3-4d7b-bea5-20d51c1a1a21

	column CO_CATEGORIA
		dataType: string
		lineageTag: 6ac1a2aa-32ef-4297-90cf-e55f6922361c

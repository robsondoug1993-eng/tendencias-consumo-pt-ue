table dim_perfil
	lineageTag: 8eb03523-b325-418b-800d-e51e51841e4d

	column CO_PERFIL
		dataType: string
		lineageTag: 9f9cefe5-9896-4eb8-a74e-e2e419d11a45
		sourceColumn: CO_PERFIL

	column NO_PERFIL
		dataType: string
		lineageTag: 46fde51b-2bdf-4e98-89ff-19becc014da3

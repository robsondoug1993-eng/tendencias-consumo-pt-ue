	partition dim_perfil = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaSaida & "dim_perfil.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"CO_PERFIL", type text}, {"NO_PERFIL", type text}, {"GRUPO", type text}, {"ORDEM", Int64.Type}}, "pt-PT")
				in
				    Tipos


createOrReplace

	expression PastaSaida = "C:\Users\Robson\Desktop\Projetos\Tendencias_Consumo_PT_UE\saida\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	table dim_ano

		column ANO
			dataType: int64
			summarizeBy: none
			formatString: 0
			sourceColumn: ANO

		column FASE
			dataType: string
			sourceColumn: FASE

		partition dim_ano = m
			mode: import
			source =
					let
					    Fonte = Csv.Document(File.Contents(PastaSaida & "dim_ano.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
					    Tipos = Table.TransformColumnTypes(Cabecalho, {{"ANO", Int64.Type}, {"FASE", type text}}, "pt-PT")
					in
					    Tipos

	table dim_tempo

		column DATA
			dataType: dateTime
			formatString: dd/mm/yyyy
			summarizeBy: none
			sourceColumn: DATA

		column ANO
			dataType: int64
			summarizeBy: none
			formatString: 0
			sourceColumn: ANO

		column MES
			dataType: int64
			summarizeBy: none
			sourceColumn: MES

		column NOME_MES
			dataType: string
			sortByColumn: MES
			sourceColumn: NOME_MES

		column TRIMESTRE
			dataType: string
			sourceColumn: TRIMESTRE

		column SEMESTRE
			dataType: string
			sourceColumn: SEMESTRE

		partition dim_tempo = m
			mode: import
			source =
					let
					    Fonte = Csv.Document(File.Contents(PastaSaida & "dim_tempo.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
					    Tipos = Table.TransformColumnTypes(Cabecalho, {{"DATA", type date}, {"ANO", Int64.Type}, {"MES", Int64.Type}, {"NOME_MES", type text}, {"TRIMESTRE", type text}, {"SEMESTRE", type text}}, "pt-PT")
					in
					    Tipos

	table dim_pais

		column CO_GEO
			dataType: string
			sourceColumn: CO_GEO

		column NO_PAIS
